{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "exec-id",
    "namespace": "agent-exec",
    "labels": {
      "owner": "agent-runtime",
      "execution_id": "id"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 37,
    "terminationGracePeriodSeconds": 5,
    "serviceAccountName": "agent-exec",
    "automountServiceAccountToken": false,
    "enableServiceLinks": false,
    "securityContext": {
      "runAsNonRoot": true,
      "runAsUser": 65532,
      "runAsGroup": 65532,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "agent",
        "image": "agent-runtime/fake-agent:r2",
        "imagePullPolicy": "Never",
        "env": [
          {
            "name": "EXECUTION_ID",
            "value": "id"
          },
          {
            "name": "EXECUTION_INPUT_B64",
            "value": "e30="
          },
          {
            "name": "EXECUTION_CREDENTIAL",
            "value": "credential"
          },
          {
            "name": "RUNTIME_URL",
            "value": "http://192.168.5.2:8000"
          }
        ],
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "resources": {
          "requests": {
            "cpu": "50m",
            "memory": "64Mi",
            "ephemeral-storage": "16Mi"
          },
          "limits": {
            "cpu": "250m",
            "memory": "128Mi",
            "ephemeral-storage": "64Mi"
          }
        },
        "volumeMounts": [
          {
            "name": "tmp",
            "mountPath": "/tmp"
          },
          {
            "name": "agent-cell",
            "mountPath": "/var/run/secrets/agent-cell",
            "readOnly": true
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "tmp",
        "emptyDir": {
          "sizeLimit": "32Mi"
        }
      },
      {
        "name": "agent-cell",
        "projected": {
          "sources": [
            {
              "serviceAccountToken": {
                "audience": "agent-cell-gateway",
                "expirationSeconds": 600,
                "path": "token"
              }
            },
            {
              "configMap": {
                "name": "kube-root-ca.crt",
                "items": [
                  {
                    "key": "ca.crt",
                    "path": "ca.crt"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
